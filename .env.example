NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPPORT_EMAIL=info@ambboutique.online

# Preview currency conversions. Refresh these before launch or connect a live rate provider.
NEXT_PUBLIC_RATE_CAD=1.38
NEXT_PUBLIC_RATE_GBP=0.75
NEXT_PUBLIC_RATE_AUD=1.53
NEXT_PUBLIC_RATE_NZD=1.70

# Stripe Checkout. The publishable key may use either variable name.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Optional private order/fulfillment destination. It must treat the Stripe
# Checkout Session ID as an idempotency key so webhook retries are safe.
ORDER_FULFILLMENT_WEBHOOK_URL=
ORDER_FULFILLMENT_WEBHOOK_SECRET=

# Add only when contact and newsletter delivery are ready.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AMB BOUTIQUE <orders@ambboutique.online>
RESEND_AUDIENCE_ID=

# Optional endpoint for consent records and SMS/email marketing platform sync.
MARKETING_CAPTURE_WEBHOOK_URL=
MARKETING_WEBHOOK_SECRET=

# Optional consent-gated, first-party behavior event destination.
BEHAVIOR_EVENT_WEBHOOK_URL=
BEHAVIOR_EVENT_WEBHOOK_SECRET=

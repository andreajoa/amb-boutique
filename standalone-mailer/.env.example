# This file belongs ONLY to standalone-mailer. Copy it to .env and keep .env private.
RESEND_API_KEY=

# Create a dedicated Resend Segment for these newsletter contacts.
RESEND_SEGMENT_ID=

FROM_EMAIL=AMB BOUTIQUE <info@ambboutique.online>
REPLY_TO=info@ambboutique.online
SITE_URL=https://ambboutique.online

# Safety switches.
# First generate/review preview.html. Then set PREVIEW_ONLY=false and SEND_LIVE=true.
PREVIEW_ONLY=true
TEST_ONLY=false
TEST_EMAIL=
SEND_LIVE=false

# Optional paths, relative to this folder.
CAMPAIGN_FILE=campaign.json
CONTACTS_DIR=contacts
CONTACT_SYNC_CONCURRENCY=4
